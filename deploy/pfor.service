[Unit]
Description=PFOR FastAPI Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/pfor
Environment=PYTHONPATH=/pfor/src
EnvironmentFile=/pfor/.env
ExecStart=/pfor/venv/bin/python -m uvicorn pfor.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
