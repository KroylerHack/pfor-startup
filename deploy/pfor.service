[Unit]
Description=PFOR FastAPI Backend
After=network.target

[Service]
Type=simple
User=delanate
Group=delanate
WorkingDirectory=/home/delanate/pfor-startup
Environment=PYTHONPATH=/home/delanate/pfor-startup/src
EnvironmentFile=/home/delanate/pfor-startup/.env
ExecStart=/home/delanate/pfor-startup/venv/bin/python -m uvicorn pfor.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target